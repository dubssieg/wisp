{
    "allthebacteria":{
        "metadata_dir": "/data/microtaxo/allthebacteria_sample/metadata",
        "assembly_dir": "/data/microtaxo/allthebacteria_sample/assembly"
    },
    "taxdb":{
        "cache_dir": "/data/microtaxo/apicache",
        "can_download": true,
        "email": "cyrille.leroux@irisa.fr"
    },
    "db":{
        "kmer_sizes": [1, 4, 7],
        "path": "/data/microtaxo/dbs",
        "tmp_path": "/data/microtaxo/tmp/db",
        "full": false,
        "window_size": 10000,
        "step": 9000,
        "species_count_limit": 10000,
        "create_db_workers": "max_minus_2",
        "db_insert_threads": "max_minus_2",
        "fanout_shards": 1,
        "fasta_batch_size": 1000,        
        "compression": "zlib",
        "merged_data_as_db": false
    },
    "model":{
        "gpu": false,
        "normalize": false,
        "num_boost_round":10,
        "scientific_name": true,
        "default_models_dir": "/data/microtaxo/models",
        "default_workspaces_dir": "/data/microtaxo/workspaces",
        "kfold": 3,
        "batch_size": 100,
        "generator_threads": 10,
        "train_batch_count": "max",
        "test_batch_count": 3,
        "eval_batch_count": 2,
        "eval_patience": 3,
        "sample_balance_factor":0,
        "batch_balance_factor": 1,
        "min_samples_by_class": 1000,
        "max_buffer_total_size": 1000 
    },
    "report":{
        "default_reports_dir": "/data/microtaxo/reports"
    },
    "log":{
        "log_path": "/data/microtaxo/logs/log.txt",
        "terminal_level": "debug",
        "file_level": "debug",
        "file_size": 10000000,
        "file_count": 3,
        "ignore_list": ["matplotlib", "PIL"]
    }
}