{
    "allthebacteria":{
        "metadata_dir": "/projects/microtaxo/exp_allthebacteria",
        "assembly_dir": "/projects/microtaxo/data/AllTheBacteria/assembly"
    },
    "api":{
        "cache_dir": "/projects/microtaxo/exp_allthebacteria/apicache",
        "can_download": true,
        "email": "cyrille.leroux@irisa.fr"
    },
    "db":{
        "kmer_size": 4,
        "path": "/projects/microtaxo/exp_allthebacteria/dbs",
        "full": false,
        "window_size": 10000,
        "step": 8000,
        "create_db_workers": "max_minus_2",
        "db_insert_threads": "max_minus_2",
        "fanout_shards": 16,
        "fasta_batch_size": 1000,
        "compressed": true,
        "merged_data_as_db": false
    },
    "model":{
        "gpu": false,
        "normalize": "min_max",
        "num_boost_round":100,
        "scientific_name": true,
        "default_models_dir": "/projects/microtaxo/exp_allthebacteria/models",
        "kfold": 5,
        "batch_size": 1000000,
        "generator_threads": "max_minus_2",
        "train_batch_count": "max",
        "test_batch_count": 4,
        "eval_batch_count": 2,
        "eval_patience": 5,
        "sample_balance_factor": 0.1,
        "batch_balance_factor": 0.8
    },
    "report":{
        "default_reports_dir": "/projects/microtaxo/exp_allthebacteria/reports"
    },
    "log":{
        "log_path": "/projects/microtaxo/exp_allthebacteria/logs/log.txt",
        "terminal_level": "warning",
        "file_level": "debug",
        "file_size": 100000000,
        "file_count": 2,
        "ignore_list": ["matplotlib"]
    }
}